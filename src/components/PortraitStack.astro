---
export type Portrait = {
  src: string;
  alt: string;
};

type Props = {
  portraits: Portrait[];
  name: string;
  role: string;
  affiliation: string;
  location: string;
};

const { portraits, name, role, affiliation, location } = Astro.props;
const stack = portraits.slice(0, 6);
---

<aside class="portrait" aria-label="Profile">
  <div class="portrait-stage">
    <div class="portrait-stack" role="img" aria-label="Portrait photos">
      {
        stack.map((portrait, index) => (
          <span
            class="portrait-print"
            data-position={String(Math.min(index, 3))}
            data-photo={String(index)}
            aria-hidden={index === 0 ? undefined : "true"}
          >
            <span class="portrait-window">
              <img
                src={portrait.src}
                alt={portrait.alt}
                width="800"
                height="1000"
                draggable="false"
                loading={index === 0 ? "eager" : "lazy"}
              />
            </span>
          </span>
        ))
      }
    </div>
    <button class="portrait-arrow portrait-arrow--prev" type="button" aria-label="Previous portrait">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m14 6-6 6 6 6"></path>
      </svg>
    </button>
    <button class="portrait-arrow portrait-arrow--next" type="button" aria-label="Next portrait">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m10 6 6 6-6 6"></path>
      </svg>
    </button>
  </div>
  <div class="portrait-dots" aria-hidden="true">
    {stack.map((_, index) => <span class:list={["portrait-dot", index === 0 ? "is-current" : ""]} />)}
  </div>
  <div class="hero__meta">
    <strong>{name}</strong>
    <span>{role} · {affiliation}</span>
    <span>{location}</span>
  </div>
</aside>

<script>
  function initPortraitStack() {
    const root = document.querySelector(".portrait");
    if (!(root instanceof HTMLElement)) return;

    const stack = root.querySelector(".portrait-stack");
    const prev = root.querySelector(".portrait-arrow--prev");
    const next = root.querySelector(".portrait-arrow--next");
    if (!(stack instanceof HTMLElement)) return;
    if (!(prev instanceof HTMLButtonElement) || !(next instanceof HTMLButtonElement)) return;

    const prints = Array.from(stack.querySelectorAll(".portrait-print"));
    const dots = Array.from(root.querySelectorAll(".portrait-dot"));
    if (prints.length < 2) return;

    let current = 0;

    const render = () => {
      prints.forEach((print, index) => {
        const offset = (index - current + prints.length) % prints.length;
        print.setAttribute("data-position", String(Math.min(offset, 3)));
        print.setAttribute("data-photo", String(index));
        if (offset === 0) {
          print.removeAttribute("aria-hidden");
        } else {
          print.setAttribute("aria-hidden", "true");
        }
      });

      dots.forEach((dot, index) => {
        dot.classList.toggle("is-current", index === current);
      });
    };

    const go = (delta: number) => {
      current = (current + delta + prints.length) % prints.length;
      render();
    };

    prev.addEventListener("click", (event) => {
      event.stopPropagation();
      go(-1);
    });

    next.addEventListener("click", (event) => {
      event.stopPropagation();
      go(1);
    });

    stack.addEventListener("click", () => go(1));

    root.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        go(-1);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        go(1);
      }
    });

    render();
  }

  initPortraitStack();
  document.addEventListener("astro:page-load", initPortraitStack);
</script>
