---
export type Portrait = {
  src: string;
  alt: string;
};

type Props = {
  portraits: Portrait[];
  name: string;
  role: string;
  affiliation: string;
  location: string;
};

const { portraits, name, role, affiliation, location } = Astro.props;
const stack = portraits.slice(0, 6);
---

<aside class="portrait" aria-label="Profile">
  <div class="portrait-stage">
    <div class="portrait-stack" role="button" tabindex="0" aria-label="Open portrait">
      {
        stack.map((portrait, index) => (
          <span
            class="portrait-print"
            data-position={String(Math.min(index, 3))}
            data-photo={String(index)}
            aria-hidden={index === 0 ? undefined : "true"}
          >
            <span class="portrait-window">
              <img
                src={portrait.src}
                alt={portrait.alt}
                width="800"
                height="1000"
                draggable="false"
                loading={index === 0 ? "eager" : "lazy"}
              />
            </span>
          </span>
        ))
      }
    </div>
    <button class="portrait-arrow portrait-arrow--prev" type="button" aria-label="Previous portrait">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m14 6-6 6 6 6"></path>
      </svg>
    </button>
    <button class="portrait-arrow portrait-arrow--next" type="button" aria-label="Next portrait">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m10 6 6 6-6 6"></path>
      </svg>
    </button>
    <button class="portrait-expand" type="button" aria-label="Expand photograph" title="Expand photograph">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5"></path>
      </svg>
    </button>
  </div>
  <div class="portrait-dots" aria-hidden="true">
    {stack.map((_, index) => <span class:list={["portrait-dot", index === 0 ? "is-current" : ""]} />)}
  </div>
  <div class="hero__meta">
    <strong>{name}</strong>
    <span>{role} · {affiliation}</span>
    <span>{location}</span>
  </div>

  <dialog class="portrait-viewer" aria-label="Expanded portrait photograph">
    <div class="portrait-full-frame">
      <img class="portrait-full-image" alt="" draggable="false" />
      <button class="portrait-viewer-arrow portrait-viewer-arrow--prev" type="button" aria-label="Previous portrait">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m14 6-6 6 6 6"></path>
        </svg>
      </button>
      <button class="portrait-viewer-arrow portrait-viewer-arrow--next" type="button" aria-label="Next portrait">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m10 6 6 6-6 6"></path>
        </svg>
      </button>
      <button class="portrait-close" type="button" aria-label="Close photograph" title="Close photograph">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </dialog>
</aside>

<script>
  function initPortraitStack() {
    const root = document.querySelector(".portrait");
    if (!(root instanceof HTMLElement) || root.dataset.portraitReady === "true") return;
    root.dataset.portraitReady = "true";

    const stack = root.querySelector(".portrait-stack");
    const prev = root.querySelector(".portrait-arrow--prev");
    const next = root.querySelector(".portrait-arrow--next");
    const expand = root.querySelector(".portrait-expand");
    const viewer = root.querySelector(".portrait-viewer");
    const frame = root.querySelector(".portrait-full-frame");
    const fullImage = root.querySelector(".portrait-full-image");
    const close = root.querySelector(".portrait-close");
    const viewerPrev = root.querySelector(".portrait-viewer-arrow--prev");
    const viewerNext = root.querySelector(".portrait-viewer-arrow--next");

    if (!(stack instanceof HTMLElement)) return;
    if (!(prev instanceof HTMLButtonElement) || !(next instanceof HTMLButtonElement)) return;
    if (!(expand instanceof HTMLButtonElement)) return;
    if (!(viewer instanceof HTMLDialogElement)) return;
    if (!(frame instanceof HTMLElement)) return;
    if (!(fullImage instanceof HTMLImageElement)) return;
    if (!(close instanceof HTMLButtonElement)) return;
    if (!(viewerPrev instanceof HTMLButtonElement) || !(viewerNext instanceof HTMLButtonElement)) return;

    const prints = Array.from(stack.querySelectorAll(".portrait-print"));
    const dots = Array.from(root.querySelectorAll(".portrait-dot"));
    const images = prints
      .map((print) => print.querySelector("img"))
      .filter((img): img is HTMLImageElement => img instanceof HTMLImageElement);

    if (prints.length === 0 || images.length === 0) return;

    let current = 0;
    let animating = false;
    let smallRect = { left: 0, top: 0, width: 0, height: 0 };
    let largeRect = { left: 0, top: 0, width: 0, height: 0 };

    const clamp = (value: number, min: number, max: number) => Math.max(min, Math.min(max, value));

    const px = (rect: { left: number; top: number; width: number; height: number }) => ({
      left: `${rect.left}px`,
      top: `${rect.top}px`,
      width: `${rect.width}px`,
      height: `${rect.height}px`,
    });

    const getSmallRect = () => {
      const windowEl = prints[current]?.querySelector(".portrait-window") ?? stack;
      const rect = windowEl.getBoundingClientRect();
      return {
        left: rect.left,
        top: rect.top,
        width: rect.width,
        height: rect.height,
      };
    };

    const getLargeRect = (origin: { left: number; top: number; width: number; height: number }) => {
      const margin = 24;
      const maxWidth = Math.min(480, window.innerWidth - margin * 2);
      const maxHeight = Math.min(600, window.innerHeight - margin * 2);
      const aspect = 4 / 5;

      let width = maxWidth;
      let height = width / aspect;
      if (height > maxHeight) {
        height = maxHeight;
        width = height * aspect;
      }

      const centerX = origin.left + origin.width / 2;
      const centerY = origin.top + origin.height / 2;

      return {
        width,
        height,
        left: clamp(centerX - width / 2, margin, window.innerWidth - margin - width),
        top: clamp(centerY - height / 2, margin, window.innerHeight - margin - height),
      };
    };

    const prefersReducedMotion = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const render = () => {
      prints.forEach((print, index) => {
        const offset = (index - current + prints.length) % prints.length;
        print.setAttribute("data-position", String(Math.min(offset, 3)));
        print.setAttribute("data-photo", String(index));
        if (offset === 0) {
          print.removeAttribute("aria-hidden");
        } else {
          print.setAttribute("aria-hidden", "true");
        }
      });

      dots.forEach((dot, index) => {
        dot.classList.toggle("is-current", index === current);
      });

      const active = images[current];
      if (active) {
        fullImage.src = active.currentSrc || active.src;
        fullImage.alt = active.alt;
      }
    };

    const layoutViewer = () => {
      smallRect = getSmallRect();
      largeRect = getLargeRect(smallRect);
      Object.assign(frame.style, px(largeRect));
    };

    const animateFrame = async (
      from: { left: number; top: number; width: number; height: number },
      to: { left: number; top: number; width: number; height: number },
    ) => {
      Object.assign(frame.style, px(to));
      if (prefersReducedMotion()) return;

      await frame.animate([px(from), px(to)], {
        duration: 520,
        easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      }).finished;
    };

    const go = (delta: number) => {
      current = (current + delta + prints.length) % prints.length;
      render();
      if (viewer.open) layoutViewer();
    };

    const openViewer = async () => {
      if (animating || viewer.open) return;
      animating = true;
      render();

      try {
        await fullImage.decode().catch(() => undefined);
        smallRect = getSmallRect();
        largeRect = getLargeRect(smallRect);

        Object.assign(frame.style, px(smallRect));
        document.documentElement.classList.add("portrait-viewer-open");
        viewer.showModal();
        viewer.classList.add("is-transitioning");

        await animateFrame(smallRect, largeRect);
        close.focus();
      } finally {
        viewer.classList.remove("is-transitioning");
        animating = false;
      }
    };

    const closeViewer = async () => {
      if (!viewer.open || animating) return;
      animating = true;
      viewer.classList.add("is-closing", "is-transitioning");

      try {
        smallRect = getSmallRect();
        await animateFrame(largeRect, smallRect);
        viewer.close();
      } finally {
        viewer.classList.remove("is-closing", "is-transitioning");
        document.documentElement.classList.remove("portrait-viewer-open");
        animating = false;
        expand.focus({ preventScroll: true });
      }
    };

    prev.addEventListener("click", (event) => {
      event.stopPropagation();
      go(-1);
    });

    next.addEventListener("click", (event) => {
      event.stopPropagation();
      go(1);
    });

    viewerPrev.addEventListener("click", (event) => {
      event.stopPropagation();
      go(-1);
    });

    viewerNext.addEventListener("click", (event) => {
      event.stopPropagation();
      go(1);
    });

    expand.addEventListener("click", (event) => {
      event.stopPropagation();
      void openViewer();
    });

    stack.addEventListener("click", () => {
      void openViewer();
    });

    stack.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        void openViewer();
      }
    });

    close.addEventListener("click", () => {
      void closeViewer();
    });

    viewer.addEventListener("cancel", (event) => {
      event.preventDefault();
      void closeViewer();
    });

    viewer.addEventListener("click", (event) => {
      if (event.target === viewer) void closeViewer();
    });

    viewer.addEventListener("close", () => {
      document.documentElement.classList.remove("portrait-viewer-open");
    });

    document.addEventListener("keydown", (event) => {
      if (!viewer.open) return;
      if (event.key === "Escape") void closeViewer();
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        go(-1);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        go(1);
      }
    });

    window.addEventListener("resize", () => {
      if (viewer.open && !animating) layoutViewer();
    });

    render();
  }

  initPortraitStack();
  document.addEventListener("astro:page-load", initPortraitStack);
</script>
